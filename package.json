{
  "name": "ngx-bootstrap-icons-picker",
  "version": "22.0.1",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run build-lib && npm run build-demo",
    "watch": "ng build lib --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:browser": "ng test --configuration browser --watch=false",
    "watch-lib": "ng build lib --watch --configuration development",
    "watch-demo": "ng serve demo",
    "build-lib": "ng build lib",
    "build-demo": "ng build demo --base-href=/ngx-bootstrap-icons-picker/",
    "sync:icons": "node scripts/sync-icons.mjs",
    "check:icons": "node scripts/sync-icons.mjs --check"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "1.13.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.19.0",
    "@vitest/browser-playwright": "^5.0.3",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.3",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
